{
  "name": "browser-llm-bench",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-worker.mjs && npm run build:seo -- --development && next dev --hostname 127.0.0.1 --port 3000",
    "build": "npm run validate:reports && node scripts/build-worker.mjs && npm run build:seo && next build",
    "preview": "tsx harness/controller/server.ts --site-only",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/unit/*.test.ts",
    "test:harness": "python3 -m unittest discover -s harness/tests",
    "validate:reports": "tsx scripts/validate-reports.ts",
    "harness": "tsx harness/controller/server.ts",
    "harness:launch": "python3 -m harness.controller.launch",
    "harness:capture": "zsh harness/collectors/macos/start-capture.command",
    "harness:publish": "tsx harness/publishing/publish.ts",
    "format:check": "prettier --check src harness/controller harness/publishing/*.ts scripts/*.ts scripts/*.mjs tests/**/*.ts catalog/*.json",
    "format": "prettier --write src harness/controller harness/publishing/*.ts scripts/*.ts scripts/*.mjs tests/**/*.ts catalog/*.json",
    "test:integration": "tsx --test tests/integration/*.test.ts",
    "verify:export": "tsx scripts/verify-export.ts",
    "check:unused": "knip --include files,dependencies,unlisted,unresolved --no-progress",
    "check": "npm run typecheck && npm test && npm run test:harness && npm run test:integration && npm run check:unused && npm run format:check",
    "build:brand": "node scripts/build-brand-assets.mjs",
    "build:seo": "tsx scripts/build-seo.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@mlc-ai/web-llm": "0.2.82",
    "@mlc-ai/web-llm-next": "npm:@mlc-ai/web-llm@0.2.86",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "16.4.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.3.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@next/env": "16.4.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "0.28.2",
    "knip": "6.12.0",
    "prettier": "3.8.3",
    "sharp": "0.35.5",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3"
  }
}
